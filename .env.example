# Cruzo — copy this file to `.env` and fill in the two values from your
# Supabase project (Project Settings -> API). Both are safe to ship inside the
# app: the anon key is a public client key, and `supabase/schema.sql` is what
# actually constrains access.
#
# Metro inlines EXPO_PUBLIC_* variables at bundle time, so restart the dev
# server after editing this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
