{
  "expo": {
    "name": "Cruzo",
    "slug": "cruzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cruzo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E13",
    "newArchEnabled": true,
    "android": {
      "package": "com.cruzo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF5C1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cruzo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E13",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cruzo shares your live position with riders in your party so the group can stay together.",
          "locationWhenInUsePermission": "Cruzo shares your live position with riders in your party so the group can stay together.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cruzo uses the camera to scan a party's QR code so you can join a ride.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-splash-screen",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
