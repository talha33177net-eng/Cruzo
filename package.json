{
  "name": "cruzo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-incall-manager": "^4.3.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "prebuild": "expo prebuild --platform android --clean",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "tsc --ignoreConfig src/lib/geo.ts src/lib/rideCode.ts src/lib/polyline.ts src/lib/navigation.ts src/lib/groupTrip.ts src/lib/chat.ts src/lib/voice.ts --outDir .test-build --module commonjs --target es2020 --skipLibCheck && node scripts/logic-tests.js && node scripts/nav-tests.js",
    "check:routing": "tsc --ignoreConfig src/lib/polyline.ts src/lib/navigation.ts --outDir .test-build --module commonjs --target es2020 --skipLibCheck && node scripts/reroute-check.js",
    "icons": "node scripts/make-icons.js",
    "check:realtime": "node scripts/check-realtime.js"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.2.3"
  }
}
